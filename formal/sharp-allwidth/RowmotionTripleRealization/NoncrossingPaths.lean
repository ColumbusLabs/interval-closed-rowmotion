import RowmotionTripleRealization.BlockBuilder

namespace Rowmotion

/-- Any two-segment path joining opposite sides of a chord crosses it. -/
theorem cyclicOrder_split {N : Nat} {a b c d z : Fin N}
    (h : CyclicOrder a b c d) (hzb : z ≠ b) (hzd : z ≠ d) :
    CyclicOrder a b z d ∨ CyclicOrder z b c d := by
  have hzb' : z.val ≠ b.val := fun hh => hzb (Fin.ext hh)
  have hzd' : z.val ≠ d.val := fun hh => hzd (Fin.ext hh)
  rcases h with h | h | h | h <;> unfold CyclicOrder <;> omega

theorem cyclicOrder_cycle {N : Nat} {a b c d : Fin N}
    (h : CyclicOrder a b c d) : CyclicOrder b c d a := by
  unfold CyclicOrder at *
  omega

namespace CircularPartition

/-- A two-segment path in one equivalence class can be replaced by an arc
still crossing the opposite class, with orientation tracked explicitly. -/
theorem crossing_arc_witness {N : Nat} (P : CircularPartition N)
    (Arc : Fin N → Fin N → Prop)
    (arcrel : ∀ x y, Arc x y → P.related x y = true)
    (paths : ∀ x y, P.related x y = true →
      x = y ∨ Arc x y ∨ ∃ z, Arc x z ∧ Arc z y)
    {a b c d : Fin N} (hac : P.related a c = true) (hbd : P.related b d = true)
    (hab : P.related a b ≠ true) (hcross : CyclicOrder a b c d) :
    ∃ u v, Arc u v ∧ P.related a u = true ∧ P.related a v = true ∧
      CyclicOrder u b v d := by
  rcases paths a c hac with heq | harc | ⟨z,haz,hzc⟩
  · rw [heq] at hcross
    unfold CyclicOrder at hcross
    omega
  · exact ⟨a,c,harc,P.reflexive a,hac,hcross⟩
  · have hazr := arcrel a z haz
    have hzne_b : z ≠ b := by intro he; rw [he] at hazr; exact hab hazr
    have hzne_d : z ≠ d := by
      intro he
      rw [he] at hazr
      exact hab (P.transitive a d b hazr (by rw [P.symmetric]; exact hbd))
    rcases cyclicOrder_split hcross hzne_b hzne_d with hz | hz
    · exact ⟨a,z,haz,P.reflexive a,hazr,hz⟩
    · exact ⟨z,c,hzc,hazr,hac,hz⟩

/-- A partition generated by paths of at most two noncrossing arcs is
noncrossing. This is the graph-to-block step for a collapsed valley. -/
theorem noncrossing_of_two_step_arcs {N : Nat} (P : CircularPartition N)
    (Arc : Fin N → Fin N → Prop)
    (arcrel : ∀ x y, Arc x y → P.related x y = true)
    (paths : ∀ x y, P.related x y = true →
      x = y ∨ Arc x y ∨ ∃ z, Arc x z ∧ Arc z y)
    (hn : ∀ a b c d, Arc a c → Arc b d → ¬ CyclicOrder a b c d) :
    P.Noncrossing := by
  intro a b c d hac hbd hcross
  by_contra hab
  obtain ⟨u,v,huv,hau,hav,huvCross⟩ := P.crossing_arc_witness Arc arcrel paths hac hbd hab hcross
  have hdu : P.related d u ≠ true := by
    intro h
    have had := P.transitive a u d hau (by rw [P.symmetric]; exact h)
    exact hab (P.transitive a d b had (by rw [P.symmetric]; exact hbd))
  obtain ⟨x,y,hxy,hdx,hdy,hxyCross⟩ := P.crossing_arc_witness Arc arcrel paths
    (by rw [P.symmetric]; exact hbd) (arcrel u v huv) hdu
    (cyclicOrder_cycle (cyclicOrder_cycle (cyclicOrder_cycle huvCross)))
  exact hn x u y v hxy huv hxyCross

end CircularPartition
end Rowmotion
